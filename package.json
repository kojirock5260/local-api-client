{
  "name": "local-api-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "demo": "node scripts/demo-server.mjs",
    "screenshots": "node scripts/store-screenshots.mjs",
    "pack": "npm run build && cd dist && zip -qr ../store/local-api-client-$npm_package_version.zip . -x .DS_Store '*/.DS_Store' && ls -la ../store/*.zip"
  },
  "dependencies": {
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/chrome": "^0.0.280",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
